# Build against the oldest supported libc, never against the developer's newer
# Fedora libc. Qt SDK is mounted separately and pinned in dependencies.json.
FROM docker.io/library/ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    g++ cmake ninja-build pkg-config file desktop-file-utils libfftw3-dev libgl1-mesa-dev libvulkan-dev \
    libxkbcommon-dev libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 \
    libxcb-keysyms1 libxcb-render-util0 libxcb-image0 libxcb-xinerama0 \
    libxcb-randr0 libxcb-shape0 libxcb-sync1 libxcb-xfixes0 libxcb-xkb1 \
    libfontconfig1 libfreetype6 libdbus-1-3 libglib2.0-0t64 libwayland-client0 \
    libwayland-cursor0 libwayland-egl1 fonts-dejavu-core \
    python3 python3-venv python3-numpy python3-scipy nodejs ca-certificates libssl3t64 \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /workspace
WORKDIR /workspace
