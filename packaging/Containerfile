# Build against the oldest supported libc, never against the developer's newer
# Fedora libc. Qt SDK is installed separately and pinned in dependencies.json.
# Jammy's Node.js predates node:test; copy only the pinned upstream test tool.
FROM docker.io/library/node:24.22.0-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS node
FROM docker.io/library/ubuntu:22.04@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's/^# deb-src /deb-src /' /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    g++ cmake ninja-build pkg-config file desktop-file-utils libfftw3-dev libgl1-mesa-dev libvulkan-dev \
    libxkbcommon-dev libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 \
    libxcb-keysyms1 libxcb-render-util0 libxcb-image0 libxcb-xinerama0 \
    libxcb-randr0 libxcb-shape0 libxcb-sync1 libxcb-xfixes0 libxcb-xkb1 \
    libfontconfig1 libfreetype6 libdbus-1-3 libglib2.0-0 libwayland-client0 \
    libwayland-cursor0 libwayland-egl1 fonts-dejavu-core \
    python3 python3-venv python3-numpy python3-scipy binutils ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN node --version
RUN mkdir -p /workspace
WORKDIR /workspace
